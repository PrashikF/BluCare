# --- Groq API Credentials ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_SECONDARY=your_secondary_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- LangSmith Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=symptom-triage-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=medical_triage_kb

# --- Embeddings & Reranker ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
BGE_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- Application Limits ---
APP_ENV=development
MAX_INTAKE_TURNS=7
CONFIDENCE_THRESHOLD=0.75
VITE_API_BASE_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# --- Backend Application & Server ---
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
RATE_LIMIT_PER_MINUTE=60

# --- Redis Cache & State Checkpointer ---
REDIS_URL=redis://localhost:6379/0

# --- Clerk Authentication ---
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=your_clerk_secret_key_here
