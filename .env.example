# ==============================================================================
# BluCare+ Centralized Shared Environment Variables Template
# Single Canonical Source of Truth for Backend & Frontend Services
# ==============================================================================

# --- Frontend (Vite Client) Configuration ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
VITE_API_BASE_URL=http://localhost:8000

# --- Backend Application & Server Configuration ---
APP_ENV=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
RATE_LIMIT_PER_MINUTE=60

# --- Groq LLM API Credentials ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY_SECONDARY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=medical_triage_kb

# --- Redis Cache & State Checkpointer ---
REDIS_URL=redis://localhost:6379/0

# --- Clerk Authentication (Backend JWKS Verification) ---
CLERK_ISSUER_URL=https://clerk.accepted.catfish-84.clerk.accounts.dev
CLERK_JWKS_URL=

# --- LangSmith Tracing & Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=symptom-triage-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- RAG Embeddings & Reranker Pipeline ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
BGE_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- Retrieval Tuning ---
SCORE_THRESHOLD=0.70
FETCH_K=20
MMR_K=10
MMR_LAMBDA=0.5
FINAL_K=5

# --- Clinical Triage Thresholds ---
MAX_INTAKE_TURNS=7
CONFIDENCE_THRESHOLD=0.75
